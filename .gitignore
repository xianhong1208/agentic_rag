# File storage (keep directory structure but ignore actual files)
storage/*
!storage/.gitkeep
data/*

# docling
assets/*
# 本地測試/覆蓋率輸出(CI 內自產)
reports/

# 評測素材不進 repo(可能含內部資料;基線 JSON 要進)
evals/rag/documents/*
evals/asr/audio/*
evals/asr/golden_transcripts/*
evals/asr/drafts/*
!evals/**/.gitkeep

# Local environment overrides (DATABASE_URL etc.) — never commit real secrets
.env

# Node / frontend build deps
node_modules/

# The generic lib/ rule above must not hide the console source helpers.
!frontend/src/lib/

# Core dumps (a crashed server process leaves a multi-GB core.<pid> here)
core.*
